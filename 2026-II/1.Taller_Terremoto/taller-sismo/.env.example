# Google Sheets (service account detective-redes@complejidad-496215)
# Copiar a .env.local para desarrollo, o configurar en Vercel (Project Settings →
# Environment Variables). Si NO se definen, la app guarda en un archivo temporal
# local: útil en desarrollo, inservible en producción (la app devuelve 503).

GOOGLE_SERVICE_ACCOUNT_EMAIL=detective-redes@complejidad-496215.iam.gserviceaccount.com
# La private key del JSON del service account, en una sola línea con \n literales:
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# ID del spreadsheet del curso (la parte entre /d/ y /edit en la URL):
SHEET_ID=1pquFP4e-SMK1gTYJQNSz8AtV2Ce7V0MDwlPSSQhKW3c
# Pestaña donde caen las respuestas (se crea sola en el primer guardado):
SHEET_TAB=taller_sismo
